# Public browser values also live in src/config/*.ts (bundled into public/).
# Edge Function secrets are set with `supabase secrets set NAME=...` and
# must never be copied under src/.
#
# Names only — fill values locally; do not commit them.

# --- Browser / src/config (public by design) ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# PAYPAL_CLIENT_ID=
# PAYPAL_ENV=sandbox

# --- Edge Function secrets (server only) ---
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
